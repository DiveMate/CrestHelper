# ---- Android / Gradle ----
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
android/.kotlin/
android/local.properties
*.apk
*.aab
*.hprof
captures/

# ---- 工作区私记 ----
# .workbuddy/memory 里是开发过程的私人记录（含本机路径、设备 MAC、调试过程），
# 不进公开仓库。
.workbuddy/

# ---- 原生构建产物 ----
build/*.exe
*.o
*.so
*.a
*.dll
*.dylib

# ---- 生成产物（可由 tools/analyze.py 重新生成）----
# web/app-data.js 是页面直接引用的那份，必须留在仓库里；
# web/app.json 只是同一份数据的中间产物，别把 1.6 MB 的重复内容推上去。
web/app.json

# ---- 个人数据：不入库 ----
# samples.csv 是逐点剖面（253 条 × 240 点 ≈ 6 万行），属于个人潜水轨迹，只留本地。
# 它已经被 git filter-branch 从历史里抹掉了；需要时用 `python tools/batch_parse.py`
# 从 raw/ 重新生成。debug 构建会自动把 data/*.csv 拷进 assets，release 包不带。
data/samples.csv
android/app/src/main/assets/samples.csv

# ---- 原始记录：仓库只带三条样本 ----
# raw/ 里是从手表下载的原始 .bin（个人潜水轨迹）。公开仓库只保留三条代表样本
# （最深 / 最长 / 最早各一条）用于验证解析链路，其余留本地、不入库。
raw/*.bin
!raw/cr4_dive00224_20261011_013812.bin
!raw/cr4_dive00213_20261011_013854.bin
!raw/cr4_dive00001_20261011_012350.bin

# ---- 签名材料：绝不入库 ----
*.keystore
*.jks
*.p12
*.pem
*.pfx
android/keystore.properties

# ---- 发布产物（APK 走 GitHub Release，不进仓库历史）----
dist/

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/

# ---- 编辑器 / 系统 ----
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
*.swp

# ---- 本地临时输出 ----
out/
tmp/
*.log
