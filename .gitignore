# ---- Android / Gradle ----
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
android/.kotlin/
android/local.properties
*.apk
*.aab
*.hprof
captures/

# ---- 原生构建产物 ----
build/*.exe
*.o
*.so
*.a
*.dll
*.dylib

# ---- 生成产物（可由 tools/analyze.py 重新生成）----
# web/app-data.js 是页面直接引用的那份，必须留在仓库里；
# web/app.json 只是同一份数据的中间产物，别把 1.6 MB 的重复内容推上去。
web/app.json

# ---- 个人数据：不入库 ----
# samples.csv 是逐点剖面（253 条 × 240 点 ≈ 6 万行），属于个人潜水轨迹，
# 只留本地。需要时用 `python tools/batch_parse.py` 从 raw/ 重新生成，
# 再复制到 android/app/src/main/assets/。缺了它 App 照样能跑，只是没有曲线。
data/samples.csv
android/app/src/main/assets/samples.csv

# ---- 签名材料：绝不入库 ----
*.keystore
*.jks
*.p12
*.pem
*.pfx
android/keystore.properties

# ---- 发布产物（APK 走 GitHub Release，不进仓库历史）----
dist/

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/

# ---- 编辑器 / 系统 ----
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
*.swp

# ---- 本地临时输出 ----
out/
tmp/
*.log
